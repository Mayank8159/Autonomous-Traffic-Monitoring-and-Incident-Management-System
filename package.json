{
  "name": "autonomous-traffic-monitoring",
  "private": true,
  "scripts": {
    "dev": "cd packages/frontend && next dev --port 3000",
    "build": "cd packages/frontend && next build",
    "start": "cd packages/frontend && next start",
    "lint": "cd packages/frontend && next lint",
    "deploy:backend": "cd packages/backend && sam build && sam deploy --guided",
    "deploy:frontend": "cd packages/frontend && vercel deploy"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=18"
  }
}
