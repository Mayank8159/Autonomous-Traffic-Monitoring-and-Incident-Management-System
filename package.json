{
  "name": "autonomous-traffic-monitoring",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "deploy:backend": "cd packages/backend && sam build && sam deploy --guided",
    "deploy:frontend": "cd packages/frontend && vercel deploy",
    "deploy": "turbo deploy"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=18"
  }
}
